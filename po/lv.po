#. localize the semicolons! The list MUST also end with a semicolon!
#: gsearchtool/data/mate-search-tool.desktop.in:13
msgid ""
"MATE;search;files;locate;documents;folders;computer;name;content;find;tool;"
msgstr ""
"meklēt;faili;dokumenti;mapes;dators;nosaukums;saturs;atrast;rīks;MATE;search;files;locate;documents;folders;computer;name;content;find;tool;"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:5
msgid "Search history"
msgstr "Meklēšanas vēsture"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:6
msgid "This key defines the items which were searched for in the past."
msgstr "Šī atslēga nosaka iepriekš meklētos vienumus."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:10
msgid "Show Additional Options"
msgstr "Rādīt papildu opcijas"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:14
msgid "Disable Quick Search"
msgstr "Atspējot ātro meklēšanu"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:15
msgid ""
"This key determines if the search tool disables the use of the locate "
"command when performing simple file name searches."
msgstr ""
"Šī atslēga nosaka, vai meklēšanas rīks, veicot vienkāršu failu nosaukumu "
"meklēšanu, atspējo komandas locate lietošanu."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:19
msgid "Quick Search Excluded Paths"
msgstr "Ātrajā meklēšanā izslēgtie ceļi"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:20
msgid ""
"This key defines the paths the search tool will exclude from a quick search."
" The wildcards '*' and '?' are supported. The default values are /mnt/*, "
"/media/*, /dev/*, /tmp/*, /proc/*, and /var/*."
msgstr ""
"Šī atslēga nosaka ceļus, ko meklēšanas rīks izslēgs no ātrās meklēšanas. "
"Tiek atbalstītas aizstājējzīmes '*' un '?'. Noklusējuma vērtības ir /mnt/*, /"
"media/*, /dev/*, /tmp/*, /proc/* un /var/*."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:24
msgid "Disable Quick Search Second Scan"
msgstr "Atspējot ātrās meklēšanas otro skenēšanu"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:25
msgid ""
"This key determines if the search tool disables the use of the find command "
"after performing a quick search."
msgstr ""
"Šī atslēga nosaka, vai meklēšanas rīks pēc ātrās meklēšanas atspējo komandas "
"find lietošanu."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:29
msgid "Quick Search Second Scan Excluded Paths"
msgstr "Ātrās meklēšanas otrajā skenēšanā izslēgtie ceļi"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:30
msgid ""
"This key defines the paths the search tool will exclude from a second scan "
"when performing a quick search. The second scan uses the find command to "
"search for files. The purpose of the second scan is to find files that have "
"not been indexed. The wildcards '*' and '?' are supported. The default value"
" is /."
msgstr ""
"Šī atslēga nosaka ceļus, ko meklēšanas rīks izslēgs no otrās skenēšanas, "
"veicot ātro meklēšanu. Otrā skenēšana failu meklēšanai izmanto komandu find. "
"Otrās skenēšanas mērķis ir atrast neindeksētus failus. Tiek atbalstītas "
"aizstājējzīmes '*' un '?'. Noklusējuma vērtība ir /."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:34
msgid "Search Result Columns Order"
msgstr "Meklēšanas rezultātu kolonnu secība"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:35
msgid ""
"This key defines the order of the columns in the search results. This key "
"should not be modified by the user."
msgstr ""
"Šī atslēga nosaka meklēšanas rezultātu kolonnu secību. Lietotājam šo atslēgu "
"nevajadzētu mainīt."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:39
msgid "Default Window Width"
msgstr "Noklusējuma loga platums"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:40
msgid ""
"This key defines the window width, and it's used to remember the size of the"
" search tool between sessions. Setting it to -1 will make the search tool "
"use the default width."
msgstr ""
"Šī atslēga nosaka loga platumu, un to izmanto, lai atcerētos meklēšanas rīka "
"izmēru starp sesijām. Iestatot to uz -1, meklēšanas rīks izmantos "
"noklusējuma platumu."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:44
msgid "Default Window Height"
msgstr "Noklusējuma loga augstums"

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:45
msgid ""
"This key defines the window height, and it's used to remember the size of "
"the search tool between sessions. Setting it to -1 will make the search tool"
" use the default height."
msgstr ""
"Šī atslēga nosaka loga augstumu, un to izmanto, lai atcerētos meklēšanas "
"rīka izmēru starp sesijām. Iestatot to uz -1, meklēšanas rīks izmantos "
"noklusējuma augstumu."

#: gsearchtool/data/org.mate.search-tool.gschema.xml.in:49
